{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-mcp-apps": {
      "projectType": "library",
      "root": "projects/ngx-mcp-apps",
      "sourceRoot": "projects/ngx-mcp-apps",
      "prefix": "mcp",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/ngx-mcp-apps/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-mcp-apps/tsconfig.spec.json"
          }
        }
      }
    },
    "example": {
      "projectType": "application",
      "root": "docs/apps/example",
      "sourceRoot": "docs/apps/example/src",
      "prefix": "mcp",
      "architect": {
        "build": {
          "builder": "ngx-mcp-apps-builder:application",
          "options": {
            "outputPath": "dist/example",
            "browser": "docs/apps/example/src/main.ts",
            "index": "docs/apps/example/src/index.html",
            "tsConfig": "docs/apps/example/tsconfig.app.json",
            "styles": ["docs/apps/example/src/styles.css"],
            "singleFile": "dist/example.html",
            "outputHashing": "none"
          }
        }
      }
    },
    "one-file": {
      "projectType": "application",
      "root": "docs/apps/one-file",
      "sourceRoot": "docs/apps/one-file/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-mcp-apps-builder:application",
          "options": {
            "outputPath": "dist/one-file",
            "browser": "docs/apps/one-file/src/main.ts",
            "index": "docs/apps/one-file/src/index.html",
            "tsConfig": "docs/apps/one-file/tsconfig.app.json",
            "singleFile": "dist/one-file.html",
            "outputHashing": "none"
          }
        }
      }
    },
    "gallery": {
      "projectType": "application",
      "root": "docs/apps/gallery",
      "sourceRoot": "docs/apps/gallery/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-mcp-apps-builder:application",
          "options": {
            "outputPath": "dist/gallery",
            "browser": "docs/apps/gallery/src/main.ts",
            "index": "docs/apps/gallery/src/index.html",
            "tsConfig": "docs/apps/gallery/tsconfig.app.json",
            "singleFile": "dist/gallery.html",
            "outputHashing": "none"
          }
        }
      }
    },
    "chart": {
      "projectType": "application",
      "root": "docs/apps/chart",
      "sourceRoot": "docs/apps/chart/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-mcp-apps-builder:application",
          "options": {
            "outputPath": "dist/chart",
            "browser": "docs/apps/chart/src/main.ts",
            "index": "docs/apps/chart/src/index.html",
            "tsConfig": "docs/apps/chart/tsconfig.app.json",
            "singleFile": "dist/chart.html",
            "outputHashing": "none"
          }
        }
      }
    },
    "routing": {
      "projectType": "application",
      "root": "docs/apps/routing",
      "sourceRoot": "docs/apps/routing/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-mcp-apps-builder:application",
          "options": {
            "outputPath": "dist/routing",
            "browser": "docs/apps/routing/src/main.ts",
            "index": "docs/apps/routing/src/index.html",
            "tsConfig": "docs/apps/routing/tsconfig.app.json",
            "singleFile": "dist/routing.html",
            "outputHashing": "none"
          }
        }
      }
    },
    "security": {
      "projectType": "application",
      "root": "docs/apps/security",
      "sourceRoot": "docs/apps/security/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-mcp-apps-builder:application",
          "options": {
            "outputPath": "dist/security",
            "browser": "docs/apps/security/src/main.ts",
            "index": "docs/apps/security/src/index.html",
            "tsConfig": "docs/apps/security/tsconfig.app.json",
            "singleFile": "dist/security.html",
            "outputHashing": "none"
          }
        }
      }
    }
  }
}
