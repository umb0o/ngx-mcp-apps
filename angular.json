{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-mcp-apps": {
      "projectType": "library",
      "root": "projects/ngx-mcp-apps",
      "sourceRoot": "projects/ngx-mcp-apps",
      "prefix": "mcp",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/ngx-mcp-apps/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-mcp-apps/tsconfig.spec.json"
          }
        }
      }
    },
    "example": {
      "projectType": "application",
      "root": "projects/example",
      "sourceRoot": "projects/example/src",
      "prefix": "mcp",
      "architect": {
        "build": {
          "builder": "ngx-mcp-apps-builder:application",
          "options": {
            "outputPath": "dist/example",
            "browser": "projects/example/src/main.ts",
            "index": "projects/example/src/index.html",
            "tsConfig": "projects/example/tsconfig.app.json",
            "styles": ["projects/example/src/styles.css"],
            "singleFile": "dist/example.html",
            "outputHashing": "none"
          }
        }
      }
    }
  }
}
